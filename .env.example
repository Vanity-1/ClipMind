# ============================================================
# ClipMind 环境配置
# ============================================================
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env 填写你的配置
#
# 注意：大多数配置也可通过应用内设置面板修改，
#       settings.json 优先级高于 .env 文件。
# ============================================================

# ---- 安全配置 ----
# Cookie 加密密钥（Fernet.generate_key().decode() 生成）
# 留空时 DEBUG=true 会自动生成临时密钥，生产环境必须设置固定值
COOKIE_ENCRYPTION_KEY=your-fernet-key-here

# 应用访问密码（空字符串表示无密码保护）
AUTH_PASSWORD=

# ---- 调试 ----
DEBUG=false
LOG_LEVEL=INFO

# ---- LLM 配置 ----
# Provider: api（OpenAI 兼容接口）或 ollama（本地模型）
LLM_PROVIDER=api
LLM_MODEL=gpt-4-turbo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama 本地模式（LLM_PROVIDER=ollama 时生效）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Embedding 配置 ----
# Provider: openai / dashscope / ollama / nvidia / local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---- ASR（语音转文字）配置 ----
# Provider: dashscope（阿里云）或 local（faster-whisper 本地模型）
ASR_PROVIDER=local
ASR_API_KEY=
ASR_MODEL=paraformer-v2
ASR_TIMEOUT=300

# 本地 Whisper 模型（ASR_PROVIDER=local 时生效）
# 可选值: tiny / base / small / medium / large-v3
ASR_MODEL_LOCAL=medium
ASR_WHISPER_TIMEOUT=300

# HuggingFace 镜像（国内下载 faster-whisper 模型时使用）
HF_MIRROR_URL=https://hf-mirror.com

# ---- DashScope 专用配置 ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_RECOGNITION_MODEL=paraformer-realtime-v2

# ---- 应用配置 ----
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 数据存储 ----
# 留空使用默认路径（data/ 目录下）
DATABASE_URL=
CHROMA_PERSIST_DIRECTORY=

# ---- 并发控制 ----
MAX_CONCURRENT_INGESTION=5
MAX_ASR_CONCURRENCY=2

# ---- 检索配置 ----
RETRIEVAL_CANDIDATE_K=24
RETRIEVAL_TOP_K=8
RETRIEVAL_MMR_FETCH_K=32
RETRIEVAL_MMR_LAMBDA=0.55
HYBRID_SEARCH_ENABLED=true

# ---- 浏览器池配置 ----
BROWSER_POOL_ENABLED=true
BROWSER_POOL_MAX_CONTEXTS=5
BROWSER_POOL_QRCODE_TIMEOUT=10
BROWSER_POOL_QRCODE_RETRIES=2

# ---- 文本分块 ----
CHUNK_SIZE=280
CHUNK_OVERLAP=50

# ---- 离线模式 ----
# 开启后拦截所有外网请求（DashScope/B站/抖音 API）
OFFLINE_MODE=false

# ---- Langfuse 可观测性（可选） ----
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com